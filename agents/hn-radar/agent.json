{
  "id": "hn-radar",
  "name": "Hacker News Radar",
  "version": 1,
  "runtime": "python",
  "entrypoint": "main.py",
  "base_image": "dispatchkit-agent:latest",
  "tick_interval": 60.0,
  "api_port": 8080,
  "chat_enabled": true,
  "commands": [
    {
      "name": "status",
      "description": "Keywords, pending mentions and last runs",
      "template": "status"
    },
    {
      "name": "digest",
      "description": "Compile a discussion brief from pending mentions now",
      "template": "digest"
    }
  ],
  "resources": {
    "cpu_limit": 0.25,
    "memory_limit_mb": 512
  },
  "env_vars": {
    "KEYWORDS": "ai agents,autonomous agents",
    "SCAN_MINUTES": "20",
    "DIGEST_EVERY_HOURS": "24",
    "HOT_POINTS": "50",
    "MAX_MENTIONS_PER_SCAN": "25",
    "MAX_ITEMS_PER_DIGEST": "60",
    "BEDROCK_MODEL_ID": "us.anthropic.claude-sonnet-5",
    "AWS_REGION": "us-east-1",
    "LLM_DISABLED": "0",
    "NOTIFY_ON": "hot,digest",
    "NOTIFY_WEBHOOK_URL": "",
    "NOTIFY_EMAIL_TO": "",
    "SMTP_HOST": "",
    "SMTP_PORT": "587",
    "SMTP_USER": "",
    "SMTP_PASSWORD": "",
    "SMTP_FROM": ""
  },
  "goal": "Watch Hacker News around the clock for the configured keywords \u2014 brands, products, competitors, topics \u2014 surface new mentions as they appear with points and thread context, flag hot threads immediately, and compile an AI brief of what the community is saying on a regular cadence.",
  "ai_enabled": false,
  "coordination": {
    "event_bus_url": null,
    "publishes": [
      "hn.mention",
      "hn.digest"
    ],
    "subscribes": []
  },
  "tags": [
    "hackernews",
    "monitoring",
    "intel",
    "ai"
  ],
  "schedule": {
    "mode": "interval",
    "every_minutes": 15
  }
}