{
  "id": "competitor-price-watch",
  "name": "Competitor Price Watch",
  "version": 1,
  "runtime": "python",
  "entrypoint": "main.py",
  "base_image": "dispatchkit-agent:latest",
  "tick_interval": 60.0,
  "api_port": 8080,
  "chat_enabled": true,
  "commands": [
    {
      "name": "status",
      "description": "Targets, current prices, failures and last runs",
      "template": "status"
    },
    {
      "name": "prices",
      "description": "Show the current price table now",
      "template": "prices"
    },
    {
      "name": "report",
      "description": "Compile a pricing report now",
      "template": "report"
    },
    {
      "name": "watch <url>",
      "description": "Add a competitor product page to watch",
      "template": "watch "
    },
    {
      "name": "unwatch <url>",
      "description": "Stop watching a product page",
      "template": "unwatch "
    }
  ],
  "resources": {
    "cpu_limit": 0.25,
    "memory_limit_mb": 512
  },
  "env_vars": {
    "PRODUCT_URLS": "https://deathwishcoffee.com/products/light-roast-10oz|Death Wish Light Roast 10oz,https://www.tentree.com/products/mens-rain-jacket|Tentree Rain Jacket",
    "CHECK_MINUTES": "60",
    "ALERT_PCT": "5",
    "MAX_LLM_EXTRACTIONS_PER_DAY": "10",
    "REPORT_EVERY_HOURS": "168",
    "BEDROCK_MODEL_ID": "us.anthropic.claude-sonnet-5",
    "AWS_REGION": "us-east-1",
    "LLM_DISABLED": "0",
    "LLM_MAX_CALLS_PER_DAY": "30",
    "NOTIFY_ON": "price_alert",
    "NOTIFY_MIN_SCORE": "",
    "NOTIFY_WEBHOOK_URL": "",
    "NOTIFY_EMAIL_TO": "",
    "SMTP_HOST": "",
    "SMTP_PORT": "587",
    "SMTP_USER": "",
    "SMTP_PASSWORD": "",
    "SMTP_FROM": ""
  },
  "goal": "Watch competitor product pages around the clock, read the live price from each one, keep the full price history, alert the moment a price moves past the configured threshold with context on what it means, and compile a pricing report on a regular cadence.",
  "ai_enabled": false,
  "coordination": {
    "event_bus_url": null,
    "publishes": [
      "price.change",
      "price.alert",
      "price.report"
    ],
    "subscribes": []
  },
  "tags": [
    "pricing",
    "competitors",
    "monitoring",
    "intel",
    "ai"
  ],
  "schedule": {
    "mode": "interval",
    "every_minutes": 60
  }
}
