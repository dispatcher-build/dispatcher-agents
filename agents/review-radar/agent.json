{
  "id": "review-radar",
  "name": "Review Radar",
  "version": 1,
  "runtime": "python",
  "entrypoint": "main.py",
  "base_image": "dispatchkit-agent:latest",
  "tick_interval": 60.0,
  "api_port": 8080,
  "chat_enabled": true,
  "commands": [
    {
      "name": "status",
      "description": "Locations, ratings, pending reviews and last runs",
      "template": "status"
    },
    {
      "name": "report",
      "description": "Compile a reputation report now",
      "template": "report"
    },
    {
      "name": "watch <business, city>",
      "description": "Add a business location to watch",
      "template": "watch "
    },
    {
      "name": "unwatch <business>",
      "description": "Stop watching a location",
      "template": "unwatch "
    }
  ],
  "resources": {
    "cpu_limit": 0.25,
    "memory_limit_mb": 512
  },
  "env_vars": {
    "LOCATIONS": "Joe's Pizza, Brooklyn NY",
    "GOOGLE_PLACES_API_KEY": "",
    "SCAN_MINUTES": "60",
    "ALERT_BELOW_STARS": "4",
    "REPLY_DRAFTS": "1",
    "MAX_DRAFTS_PER_DAY": "10",
    "REPORT_EVERY_HOURS": "168",
    "BEDROCK_MODEL_ID": "us.anthropic.claude-sonnet-5",
    "AWS_REGION": "us-east-1",
    "LLM_DISABLED": "0",
    "LLM_MAX_CALLS_PER_DAY": "40",
    "NOTIFY_ON": "alert,rating_drop",
    "NOTIFY_MIN_SCORE": "",
    "NOTIFY_WEBHOOK_URL": "",
    "NOTIFY_EMAIL_TO": "",
    "SMTP_HOST": "",
    "SMTP_PORT": "587",
    "SMTP_USER": "",
    "SMTP_PASSWORD": "",
    "SMTP_FROM": ""
  },
  "goal": "Watch the business's Google reviews around the clock, surface every new review the moment it lands with a drafted owner reply, alert immediately on negative reviews and rating drops, and compile a reputation report on a regular cadence.",
  "ai_enabled": false,
  "coordination": {
    "event_bus_url": null,
    "publishes": [
      "review.new",
      "review.alert",
      "review.report"
    ],
    "subscribes": []
  },
  "tags": [
    "reviews",
    "reputation",
    "monitoring",
    "ai"
  ],
  "schedule": {
    "mode": "interval",
    "every_minutes": 60
  }
}