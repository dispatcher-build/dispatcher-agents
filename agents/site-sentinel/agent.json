{
  "id": "site-sentinel",
  "name": "Site Sentinel",
  "version": 1,
  "runtime": "python",
  "entrypoint": "main.py",
  "base_image": "dispatchkit-agent:latest",
  "tick_interval": 60.0,
  "api_port": 8080,
  "chat_enabled": true,
  "commands": [
    {
      "name": "status",
      "description": "Current state, uptime and response times for every site",
      "template": "status"
    },
    {
      "name": "report",
      "description": "Compile an uptime report now",
      "template": "report"
    },
    {
      "name": "watch <url>",
      "description": "Add a site to watch, optionally url|text that must be on the page",
      "template": "watch "
    },
    {
      "name": "unwatch <url>",
      "description": "Stop watching a site",
      "template": "unwatch "
    }
  ],
  "resources": {
    "cpu_limit": 0.25,
    "memory_limit_mb": 512
  },
  "env_vars": {
    "URLS": "https://github.com,https://stripe.com",
    "CHECK_MINUTES": "5",
    "FAILURES_BEFORE_ALERT": "2",
    "CERT_WARN_DAYS": "21",
    "LATENCY_WARN_MS": "5000",
    "REPORT_EVERY_HOURS": "24",
    "BEDROCK_MODEL_ID": "us.anthropic.claude-sonnet-5",
    "AWS_REGION": "us-east-1",
    "LLM_DISABLED": "0",
    "NOTIFY_ON": "incident,recovery,cert",
    "NOTIFY_WEBHOOK_URL": "",
    "NOTIFY_EMAIL_TO": "",
    "SMTP_HOST": "",
    "SMTP_PORT": "587",
    "SMTP_USER": "",
    "SMTP_PASSWORD": "",
    "SMTP_FROM": ""
  },
  "goal": "Watch the websites this business depends on around the clock. Detect outages, broken pages and slow responses within minutes, confirm them before raising an alarm, explain in plain language what broke and what to do, warn before TLS certificates expire, and report uptime on a regular cadence.",
  "ai_enabled": false,
  "coordination": {
    "event_bus_url": null,
    "publishes": [
      "site.incident",
      "site.recovery",
      "site.report"
    ],
    "subscribes": []
  },
  "tags": [
    "uptime",
    "monitoring",
    "ops",
    "ai"
  ],
  "schedule": {
    "mode": "interval",
    "every_minutes": 5
  }
}
