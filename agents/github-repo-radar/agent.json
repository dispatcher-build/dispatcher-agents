{
  "id": "github-repo-radar",
  "name": "GitHub Repo Radar",
  "version": 1,
  "runtime": "python",
  "entrypoint": "main.py",
  "base_image": "dispatchkit-agent:latest",
  "tick_interval": 300.0,
  "api_port": 8080,
  "chat_enabled": true,
  "commands": [
    {
      "name": "report",
      "description": "Write the momentum report now",
      "template": "report"
    },
    {
      "name": "track",
      "description": "Track another repository",
      "template": "track owner/repo"
    },
    {
      "name": "status",
      "description": "Tracked repos and API quota",
      "template": "status"
    }
  ],
  "resources": {
    "cpu_limit": 0.25,
    "memory_limit_mb": 512
  },
  "env_vars": {
    "REPOS": "vercel/next.js,facebook/react",
    "CHECK_HOURS": "6",
    "REPORT_EVERY_HOURS": "168",
    "GITHUB_TOKEN": "",
    "BEDROCK_MODEL_ID": "us.anthropic.claude-sonnet-5",
    "AWS_REGION": "us-east-1",
    "LLM_DISABLED": "0",
    "NOTIFY_ON": "release,report",
    "NOTIFY_WEBHOOK_URL": "",
    "NOTIFY_EMAIL_TO": "",
    "SMTP_HOST": "",
    "SMTP_PORT": "587",
    "SMTP_USER": "",
    "SMTP_PASSWORD": "",
    "SMTP_FROM": ""
  },
  "goal": "Track the configured public GitHub repositories: announce new releases as they ship, keep a star/issue history, and write a periodic AI momentum report comparing activity across the watched repos. Works without credentials; add a GitHub token for higher API limits.",
  "ai_enabled": false,
  "coordination": {
    "event_bus_url": null,
    "publishes": [
      "github.release",
      "github.report"
    ],
    "subscribes": []
  },
  "tags": [
    "github",
    "dev",
    "monitoring",
    "ai"
  ],
  "schedule": {
    "mode": "interval",
    "every_minutes": 360
  }
}
